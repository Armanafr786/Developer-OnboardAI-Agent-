{
  "name": "onboardai",
  "version": "1.0.0",
  "description": "Autonomous developer onboarding agent — analyze any codebase and generate complete documentation.",
  "main": "agent.js",
  "bin": {
    "onboardai": "./cli.js"
  },
  "scripts": {
    "start":       "node server.js",
    "analyze":     "node agent.js",
    "test":        "npx mocha test-framework.js --timeout 15000",
    "test:watch":  "npx mocha test-framework.js --watch --timeout 15000",
    "server":      "node server.js",
    "cli":         "node cli.js"
  },
  "keywords": [
    "onboarding", "documentation", "ai", "code-analysis", "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv":    "^16.4.5",
    "express":   "^4.19.2"
  },
  "devDependencies": {
    "chai":      "^4.4.1",
    "mocha":     "^10.4.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
