# OnboardAI Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is in .gitignore.

# ── AI Engine ──────────────────────────────────────────────────────────────────
# Primary engine: IBM Bob CLI (no key needed — uses your local bob installation)
# Fallback engine: Groq API (llama-3.3-70b-versatile)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Web Server ─────────────────────────────────────────────────────────────────
PORT=3000
